models/*.pth
models/*.pt
models/*.h5
models/*.keras
models/*.onnx
!models/README.md

# Large raw datasets (preserve samples)
Dataset/
data/*.zip
data/*.tar.gz
data/raw/
!data/samples/
!data/README.md

# Build & egg distribution artifacts
build/
dist/
*.egg-info/
